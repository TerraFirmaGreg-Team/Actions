{
  "name": "Server Test + spark",
  "timeout": 300,
  "totalTimeout": 900,
  "steps": [
    { "type": "ENDS_WITH", "message": "For help, type \"help\"", "timeout": 300 },
    { "type": "SEND", "message": "spark healthreport" },
    { "type": "SEND", "message": "spark tps" },
    { "type": "SEND", "message": "spark profiler stop" },
    { "type": "REGEX", "ignoreCase": true, "timeout": 240,
      "message": ".*(spark\\.lucko\\.me/|written to:|whilst (uploading|saving)|isn't running|error occurred).*" },
    { "type": "SEND", "message": "stop" }
  ]
}
